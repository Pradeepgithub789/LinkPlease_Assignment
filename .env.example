# LinkPlease Application Configuration Example
# Copy this file to '.env' and fill in your details.

# PseudoGram External Mock API Settings
PSEUDOGRAM_API_KEY=api_key
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Database Connection (SQLite local path by default)
# For Render production, this is supplied dynamically as a PostgreSQL connection string by Render PostgreSQL
DATABASE_URL=sqlite:///./linkplease.db

# Webhook Security Settings
WEBHOOK_SIGNATURE_REQUIRED=true

# Worker Retry Limits
MAX_DM_ATTEMPTS=5
MAX_RECONCILIATION_POLLS=10
